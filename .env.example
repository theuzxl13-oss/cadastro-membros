# ---------------------------------------------------------------------------
# Variáveis PÚBLICAS de build (painel administrativo). Podem ir ao navegador.
# Cloudflare Pages > Settings > Variables and Secrets (Production e Preview)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "anon" (legada) ou "publishable" (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SEGREDOS das Pages Functions (backend). Cadastre como "Secret" (criptografado).
# NUNCA use prefixo VITE_ nestes: eles não podem ir para o navegador.
# Para desenvolvimento local, copie para .dev.vars (já ignorado pelo git).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "service_role" (legada) ou "secret" (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=
# Texto aleatório longo, usado para anonimizar IPs no controle anti-spam
IP_HASH_SALT=
# Cloudflare Turnstile (anti-robô). Recomendado em produção.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opcionais
LIMITE_ENVIOS_POR_HORA=5
LIMITE_ENVIOS_POR_DIA=400
